# Resend (https://resend.com) API key — free tier covers 3,000 emails/month,
# way more than needed for hourly alerts. Sign up, verify a sending domain
# (or use their onboarding test domain for initial testing), then create
# an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sending address. Must be on a domain verified in your Resend account,
# e.g. alerts@yourdomain.com
EMAIL_FROM=alerts@yourdomain.com

# Where alerts get sent TO (comma-separated for multiple recipients).
# Defaults to EMAIL_FROM if omitted.
ALERT_EMAIL_TO=you@example.com,colleague@example.com

# Recipients for the broader QC/review digest (on-topic items that were
# excluded from the main alert for not being material/primary — useful
# for tuning the filter). Defaults to just the first ALERT_EMAIL_TO
# address if omitted, since this is a tuning tool, not for the full
# distribution list.
REVIEW_EMAIL_TO=you@example.com

# Anthropic API key for the relevance/impact-analysis step, from
# https://console.anthropic.com/settings/keys. Only fires for groups with
# new candidate articles (typically a handful per run, often zero), on the
# cheapest current model — cost at this volume should be negligible.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional override of the model used for relevance/impact analysis.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: path to the seen-articles state file.
# On Railway, point this at a mounted Volume so state survives restarts,
# e.g. /data/seen_articles.json
SEEN_FILE_PATH=seen_articles.json

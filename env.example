# Resend (https://resend.com) API key — free tier covers 3,000 emails/month,
# way more than needed for hourly alerts. Sign up, verify a sending domain
# (or use their onboarding test domain for initial testing), then create
# an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sending address. Must be on a domain verified in your Resend account,
# e.g. alerts@yourdomain.com
EMAIL_FROM=alerts@yourdomain.com

# Where alerts get sent TO (comma-separated for multiple recipients).
# Defaults to EMAIL_FROM if omitted.
ALERT_EMAIL_TO=you@example.com,colleague@example.com

# Recipients for the broader QC/review digest (on-topic items that were
# excluded from the main alert for not being material/primary — useful
# for tuning the filter). Defaults to just the first ALERT_EMAIL_TO
# address if omitted, since this is a tuning tool, not for the full
# distribution list.
REVIEW_EMAIL_TO=you@example.com

# Anthropic API key for the relevance/impact-analysis step, from
# https://console.anthropic.com/settings/keys. Only fires for groups with
# new candidate articles (typically a handful per run, often zero), on the
# cheapest current model — cost at this volume should be negligible.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional override of the model used for relevance/impact analysis.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: cross-model disagreement report ---
# Set either or both of these to enable a diagnostic-only feature: every
# candidate batch Claude assesses also gets sent to Grok and/or GPT, and
# any disagreement with Claude's relevance call gets emailed as a third,
# separate report. This never changes what goes into the main alert or
# review digest — Claude's judgment is what actually gates those. Leave
# both unset to skip this entirely (the default).
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx        (from console.x.ai)
# XAI_MODEL=grok-4-1-fast
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx       (from platform.openai.com)
# OPENAI_MODEL=gpt-5-mini
# CROSS_MODEL_REPORT_EMAIL_TO=you@example.com      (defaults to REVIEW_EMAIL_TO)

# Optional: path to the seen-articles state file.
# On Railway, point this at a mounted Volume so state survives restarts,
# e.g. /data/seen_articles.json
SEEN_FILE_PATH=seen_articles.json

# --- Optional: YouTube layer (local TV + video search) ---
# The per-channel RSS poll of local TV stations (LOCAL_TV_CHANNELS in
# monitor.py) is free, keyless, and always on — no env var needed for it.
# Setting YOUTUBE_API_KEY additionally enables a keyword-search layer
# across all of YouTube (not just curated channels), from
# https://console.cloud.google.com/apis/credentials after enabling the
# "YouTube Data API v3" on a Google Cloud project. Free tier: 10,000
# quota units/day, 100 units per search call — no billing kicks in on
# overage, it just starts failing (403 quotaExceeded) until the daily
# reset. As of 2026-09-16, video from either layer is scored and routed
# exactly like an article — a strict_relevant video reaches the main
# alert (ALERT_EMAIL_TO) just like a strict_relevant article would; see
# "Video in the main alert" in README.md.
# YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Self-imposed daily quota ceiling for the search layer above, kept below
# the real 10,000-unit/day free limit to leave headroom. Only relevant if
# YOUTUBE_API_KEY is set.
# YOUTUBE_DAILY_QUOTA_BUDGET=9000

# Gmail address the alerts are sent FROM
GMAIL_ADDRESS=youraddress@gmail.com

# Gmail App Password (NOT your normal password).
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where alerts get sent TO (defaults to GMAIL_ADDRESS if omitted)
ALERT_EMAIL_TO=you@example.com

# Optional: path to the seen-articles state file.
# On Railway, point this at a mounted Volume so state survives restarts,
# e.g. /data/seen_articles.json
SEEN_FILE_PATH=seen_articles.json
